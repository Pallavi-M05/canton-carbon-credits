module CarbonCredit where

import Daml.Script

import DA.Text (Text)
import DA.Set (Set)
import qualified DA.Set as Set
import DA.Next.TotalMap (TotalMap)
import DA.Date (Date)
import DA.Time (Time)

-- | A unique identifier for a carbon credit project.
type ProjectId = Text

-- | A unique identifier for a batch of issued credits.
type CreditUUID = Text

-- | A composite data type for uniquely identifying a specific issuance batch
-- | of carbon credits from a project.
data CreditId = CreditId with
  projectId : ProjectId
  uuid : CreditUUID
  deriving (Eq, Show, Ord)

-- | Represents a batch of fungible carbon credits from a specific project and vintage year.
-- | Credits are semi-fungible: they can be split and merged, but only with credits
-- | from the same project and vintage. An issuance workflow (defined elsewhere, e.g., on a
-- | RegistryRole contract) would create both a `CarbonCredit` for the project owner and
-- | a `BufferCredit` for the registry's buffer pool.
template CarbonCredit
  with
    issuer: Party              -- The accredited registry (e.g., Verra, Gold Standard)
    owner: Party               -- The current owner of the credits
    quantity: Decimal          -- Amount of credits in tCO2e (tonnes of CO2 equivalent)
    vintage: Int               -- The year the emission reduction occurred
    projectId: ProjectId       -- Identifier for the carbon project
    projectType: Text          -- E.g., "Afforestation/Reforestation", "Renewable Energy"
    id: CreditId               -- Unique identifier for this credit batch
    observers: Set Party       -- Additional parties who can see this credit
  where
    signatory issuer, owner
    observer observers

    key (issuer, id, owner) : (Party, CreditId, Party)
    maintainer key.issuer

    ensure quantity > 0.0

    -- | Allows the owner to split a credit holding into two smaller ones.
    -- | This is essential for trading fractional amounts.
    choice Split: (ContractId CarbonCredit, ContractId CarbonCredit)
      with
        splitQuantity: Decimal
      controller owner
      do
        ensure splitQuantity > 0.0 && splitQuantity < quantity
        let remainingQuantity = quantity - splitQuantity
        
        credit1 <- create this with quantity = splitQuantity
        credit2 <- create this with quantity = remainingQuantity
        
        return (credit1, credit2)

    -- | Initiates a two-phase transfer of the credit to a new owner.
    -- | Creates a proposal that the new owner must accept to complete the transfer.
    choice ProposeTransfer: ContractId TransferProposal
      with
        newOwner: Party
      controller owner
      do
        create TransferProposal with
          creditCid = self
          originalCredit = this
          newOwner
          observers = Set.insert newOwner this.observers

    -- | Allows the owner to permanently retire a quantity of carbon credits,
    -- | signifying that the underlying environmental benefit has been claimed.
    -- | This creates a non-revocable Retirement.Fact contract.
    -- | This choice supports partial retirement of a credit batch.
    choice Retire: (Optional (ContractId CarbonCredit), ContractId Retirement.Fact)
      with
        retireQuantity: Decimal
        retirementReason: Text
        beneficiary: Optional Text -- e.g., "Offsetting Q1 2024 emissions for ACME Corp"
        metadata: TotalMap Text Text
      controller owner
      do
        ensure retireQuantity > 0.0 && retireQuantity <= quantity

        let
          remainingQuantity = quantity - retireQuantity
          maybeRemainingCreditCid =
            if remainingQuantity > 0.0 then
              Some <$> create this with quantity = remainingQuantity
            else
              None

        -- Create the public retirement fact, which is defined in Retirement.daml
        retirementFactCid <- create Retirement.Fact with
          retiringParty = owner
          issuer
          quantity = retireQuantity
          vintage
          projectId
          projectType
          retirementReason
          beneficiary
          metadata
          retiredAt = getTime

        return (maybeRemainingCreditCid, retirementFactCid)


-- | Proposal for transferring a CarbonCredit contract. The `newOwner` must accept.
template TransferProposal
  with
    creditCid: ContractId CarbonCredit
    originalCredit: CarbonCredit
    newOwner: Party
    observers: Set Party
  where
    signatory originalCredit.owner
    observer newOwner

    choice AcceptTransfer: ContractId CarbonCredit
      controller newOwner
      do
        -- Exercise a fetch on the original contract to ensure it's still active,
        -- then create the new one in a single atomic transaction.
        archive creditCid
        create originalCredit with
          owner = newOwner
          observers -- Carry over observers, including the new one

    choice RejectTransfer: ()
      controller newOwner, originalCredit.owner
      do pure ()


-- | Represents credits allocated to the registry's buffer pool during issuance.
-- | These credits are used to insure the carbon market against project failures or
-- | reversals (e.g., a forest fire destroying a carbon sequestration project).
-- | They are held and controlled exclusively by the registry (`issuer`).
template BufferCredit
  with
    issuer: Party              -- The accredited registry
    quantity: Decimal          -- Amount of credits held in buffer
    vintage: Int               -- Vintage year of the buffered credits
    projectId: ProjectId       -- The project that contributed to this buffer pool entry
    id: CreditId               -- Links to the original issuance batch for traceability
  where
    signatory issuer

    key (issuer, id) : (Party, CreditId)
    maintainer key.issuer

    ensure quantity > 0.0

    -- | Choice for the registry to use buffer credits to cover a shortfall or reversal
    -- | in a project. This archives the buffer credit and creates a public fact about its usage.
    choice CoverReversal: ContractId BufferReversalFact
      with
        reversalReason: Text
        reversedProjectId: ProjectId -- The project that failed and is being covered
      controller issuer
      do
        create BufferReversalFact with
          registry = issuer
          usedQuantity = quantity
          bufferVintage = vintage
          bufferSourceProjectId = projectId
          reversedProjectId
          reversalReason
          coveredAt = getTime

-- | A public, immutable fact recording the use of buffer credits by a registry.
-- | This provides transparency and auditability for the insurance mechanism of the carbon market.
template BufferReversalFact
  with
    registry: Party
    usedQuantity: Decimal
    bufferVintage: Int
    bufferSourceProjectId: ProjectId
    reversedProjectId: ProjectId
    reversalReason: Text
    coveredAt: Time
  where
    signatory registry


-- | Placeholder for the Retirement contract, which is formally defined in `Retirement.daml`.
-- | This allows this module to compile independently while referencing the `Retirement.Fact` template.
module Retirement where
  template Fact
    with
      retiringParty: Party
      issuer: Party
      quantity: Decimal
      vintage: Int
      projectId: ProjectId
      projectType: Text
      retirementReason: Text
      beneficiary: Optional Text
      metadata: TotalMap Text Text
      retiredAt: Time
    where
      signatory retiringParty, issuer